# Shared provider credentials used by all agencies.
SERPER_API_KEY="YOUR_SERPER_API_KEY"
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
COHERE_API_KEY="YOUR_COHERE_API_KEY"
TOGETHER_API_KEY="YOUR_TOGETHER_API_KEY"
# Optional. Absolute path or relative to where you start the server (e.g. ./odr-key.json locally,
# /etc/secrets/odr-key.json in the container). Firestore is disabled if the file is missing.
FIREBASE_SERVICE_ACCOUNT_KEY_JSON="/path/to/your/service-account-key.json"

# Optional. Comma-separated CORS origins; defaults to "*".
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Optional provider base URLs.
OPENROUTER_API_BASE="https://openrouter.ai/api/v1"
SERPER_BASE_URL="https://google.serper.dev"
SERPER_DEFAULT_LOCATION="us"
SERPER_TIMEOUT="15"
COHERE_API_BASE="https://api.cohere.com"
TOGETHER_API_BASE="https://api.together.ai"

# Deep Research task-level model selection.
DEEP_RESEARCH_PLANNER_MODEL_ID="openai/gpt-5.4-mini"
DEEP_RESEARCH_SUMMARIZER_MODEL_ID="google/gemini-3.1-flash-lite-preview"
DEEP_RESEARCH_WRITER_MODEL_ID="google/gemini-3.1-pro-preview"
DEEP_RESEARCH_REFINER_MODEL_ID="google/gemini-3.1-flash-lite-preview"
DEEP_RESEARCH_RERANK_PROVIDER="cohere"
# Global default reranker model, can be overridden below per agency.
RERANKER_MODEL="rerank-english-v3.0"
DEEP_RESEARCH_RERANKER_MODEL="rerank-english-v3.0"

# Company Profile Extractor task-level model selection.
CPE_PLANNER_MODEL_ID="openai/gpt-5.4-mini"
CPE_EXTRACTOR_MODEL_ID="google/gemini-3.1-flash-lite-preview"
CPE_MAX_CRAWL_DEPTH="1"
CPE_MAX_CRAWL_PAGES="20"

# Scraper settings.
SCRAPER_DOWNLOAD_PDFS="false"
SCRAPER_PDF_SAVE_DIR="downloaded_pdfs"
SCRAPER_MAX_PDF_SIZE_MB="512"